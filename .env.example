NODE_ENV=production
PORT=3000
# PostgreSQL connection string. Use a managed PostgreSQL database in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set true only if your managed database requires SSL (most hosted providers do).
DATABASE_SSL=true
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=meshaqconnectionlimited@gmail.com
# Set this before first startup. Use a unique password and keep it private.
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
# SMTP credentials; notifications are skipped safely if SMTP_HOST is not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="MESHAQ CONNECTION LIMITED <no-reply@example.com>"
NOTIFY_EMAIL=meshaqconnectionlimited@gmail.com
# Set to your exact deployed origin, e.g. https://your-domain.co.ke
SITE_URL=https://your-domain.example
# WhatsApp number in international digits only (verify this before launch)
WHATSAPP_NUMBER=254712242050
